{
  "name": "election-management-voting-system",
  "version": "1.0.0",
  "private": true,
  "description": "Election Management & Voting System with accounts, nominations, voting restrictions, counting and persistent SQLite storage.",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "seed": "node --no-warnings server/seed.js",
    "reset": "node --no-warnings server/seed.js --reset",
    "test": "node --no-warnings --test",
    "test:coverage": "node --no-warnings --test --experimental-test-coverage",
    "check": "node --no-warnings scripts/check.js",
    "backup": "node --no-warnings scripts/backup.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4"
  }
}
