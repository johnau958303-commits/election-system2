# Example environment variables. This project reads the process environment
# directly and does not auto-load .env. Set these in your shell or process manager.
PORT=3000
HOST=0.0.0.0
DB_PATH=data/election.db
NODE_ENV=development
DEMO_MODE=false
AUTO_SEED=true
# ELECTION_NOW=2026-06-01T12:00:00.000Z

# Public HTTPS origin used for Google OAuth callbacks and fixed tunnels.
PUBLIC_BASE_URL=https://your-fixed-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to PUBLIC_BASE_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Email delivery: resend (real email), console (development) or test (fixed outbox).
EMAIL_MODE=console
RESEND_API_KEY=
MAIL_FROM=Election System <elections@example.com>
# Long random value used to hash one-time voter codes.
VOTER_CODE_SECRET=replace-with-a-long-random-secret
